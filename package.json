{
  "name": "steppeplan",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "description": "SteppePlan — local-first graph of project concepts, shared by humans and AI agents",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node server/index.mjs\" \"vite\"",
    "build": "vite build",
    "start": "npm run build && node server/index.mjs",
    "serve": "node server/index.mjs",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "test:ai": "node scripts/ai-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "package:linux": "node scripts/package-linux.mjs",
    "test:key": "node scripts/key-smoke.mjs",
    "mcp:note": "node scripts/mcp-note.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.12.5",
    "@xyflow/react": "^12.12.1",
    "nanoid": "^5.1.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT"
}
